{
  "_comment": "Merge into .github/hooks/hooks.json via 'forge sync'. Copilot 4-event model mapped to journey schema. Deep-merge — do not overwrite existing hooks arrays.",
  "hooks": [
    {
      "event": "session-start",
      "run": "bash .forge/primitives/journey_recorder/adapters/copilot/record-hook.sh session_start"
    },
    {
      "event": "pre-request",
      "run": "bash .forge/primitives/journey_recorder/adapters/copilot/record-hook.sh pre_tool_use"
    },
    {
      "event": "post-response",
      "run": "bash .forge/primitives/journey_recorder/adapters/copilot/record-hook.sh post_tool_use"
    },
    {
      "event": "session-end",
      "run": "bash .forge/primitives/journey_recorder/adapters/copilot/record-hook.sh session_end"
    }
  ]
}
